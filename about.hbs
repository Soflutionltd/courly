<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Ratatoskr third-party licenses</title>
<style>
body { font: 14px -apple-system, system-ui, sans-serif; margin: 2rem auto; max-width: 56rem; padding: 0 1rem; color: #1f1f1f; }
h2 { margin-top: 2.5rem; }
ul.crates { columns: 3; font-size: 12px; }
pre { white-space: pre-wrap; background: #f5f5f5; padding: 1rem; font-size: 12px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Ratatoskr is built on the following open-source software.</p>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<ul class="crates">
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
